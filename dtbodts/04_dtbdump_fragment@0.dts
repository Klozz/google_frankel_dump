	fragment@virt_dp {
		target-path = [2f 00];

		__overlay__ {

			virtio_block@4010000 {
				compatible = "virtio,mmio";
				interrupts = <0x0 0x3be 0x4 0x0>;
				phandle = <0x217>;
				reg = <0x0 0x4010000 0x0 0x10000>;
			};

			virtio_block@4020000 {
				compatible = "virtio,mmio";
				interrupts = <0x0 0x3bf 0x4 0x0>;
				phandle = <0x218>;
				reg = <0x0 0x4020000 0x0 0x10000>;
			};
		};
	};

	fragment@virt_uart {
		target-path = [2f 00];

		__overlay__ {

			clk100000000 {
				#clock-cells = <0x0>;
				clock-frequency = <0x5f5e100>;
				clock-output-names = "sysclk";
				compatible = "fixed-clock";
				phandle = <0x1>;
			};

			uart@40000000 {
				clock-names = "uartclk", "apb_pclk";
				clocks = <0x1 0x1>;
				compatible = "arm,pl011", "arm,primecell";
				interrupts = <0x0 0x3bd 0x4 0x0>;
				reg = <0x0 0x4000000 0x0 0x1000>;
			};
		};
	};
