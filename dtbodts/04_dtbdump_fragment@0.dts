			};

			xlsion_cli15_pin2 {
				bias-pull-down;
				function = "lsion_cli15";
				input-enable;
				output-disable;
				phandle = <0x1a8>;
				pins = "XLSION_CLI15_PIN2";
			};

			xlsion_cli15_pin2_sleep {
				bias-pull-down;
				function = "lsion_gpio";
				input-enable;
				output-disable;
				phandle = <0x1a9>;
				pins = "XLSION_CLI15_PIN2";
			};

			xlsion_cli15_pin3_ac6 {
				bias-disable;
				drive-strength = <0x2>;
				function = "lsion_gpio";
				input-enable;
				output-enable;
				phandle = <0x1aa>;
				pins = "XLSION_CLI15_PIN3";
			};

			xlsion_cli15_pin3_ac6_sleep {
				function = "lsion_gpio";
				input-enable;
				output-high;
				phandle = <0x1ab>;
				pins = "XLSION_CLI15_PIN3";
			};
		};
	};

