					};

					io_device_4 {
						iod,attrs = <0x0>;
						iod,ch = <0x52>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_loopback";
					};

					io_device_5 {
						iod,attrs = <0x2000>;
						iod,ch = <0xb5>;
						iod,ch_count = <0x1e>;
						iod,format = <0x1>;
						iod,io_type = <0x2>;
						iod,link_type = <0x1>;
						iod,name = "rmnet";
					};

					io_device_6 {
						iod,attrs = <0x0>;
						iod,ch = <0xd3>;
						iod,format = <0x1>;
						iod,io_type = <0x2>;
						iod,link_type = <0x1>;
						iod,name = "umts_dummy";
					};

					io_device_7 {
						iod,attrs = <0x0>;
						iod,ch = <0x0>;
						iod,format = <0x3>;
						iod,io_type = <0x3>;
						iod,link_type = <0x1>;
						iod,name = "multipdp";
					};

					io_device_8 {
						iod,attrs = <0x4200>;
						iod,ch = <0xf1>;
						iod,format = <0x4>;
						iod,io_type = <0x0>;
						iod,link_type = <0x1>;
						iod,name = "umts_boot0";
					};

					io_device_9 {
						iod,attrs = <0x0>;
						iod,ch = <0x5b>;
						iod,format = <0x0>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_rcs0";
					};
				};
			};

			gnssif {
				compatible = "samsung,exynos-gnss";
				device,name = "KEPLER";
				device_node_name = "gnss_ipc";
				gpio_ap2gnss_spi = <0xffffffff 0x12 0x1>;
				gpio_gnss2ap_spi = <0xffffffff 0x14 0x1>;
				pinctrl-0 = <0x57 0x58>;
				pinctrl-names = "default";
				status = "okay";
			};

			s5910_bb {
				#address-cells = <0x1>;
				#size-cells = <0x1>;
				clk-gpio = <0xffffffff 0x20 0x0>;
				compatible = "google,bitbang-spmi-controller";
				dat-gpio = <0xffffffff 0x21 0x0>;
				delay_us = <0xa>;
				phandle = <0x253>;
				pinctrl-0 = <0x55 0x56>;
				pinctrl-names = "default";
				status = "okay";

				pmic@0 {
					compatible = "google,cp-pmic-spmi";
					phandle = <0x54>;
					pmic-otp-reg = <0x30e>;
					reg = <0x0 0x0>;
					warm_reset_seq = <0x675 0xa1 0x0 0x67d 0xbe 0x0>;
				};

				s5910@5 {
					compatible = "google,s5910-spmi";
					phandle = <0x53>;
					reg = <0x5 0x0>;
					s5910,on_seq = <0x0 0x211 0x47 0x0 0x236 0xe 0x0 0x215 0x7f 0x0 0x20e 0x0>;
					s5910,seq = <0x0 0x215 0xf 0x3e8 0x20e 0x4 0x0 0x240 0x10>;
				};
			};
		};
	};

	fragment@sbbmux {
		target-path = [2f 00];

		__overlay__ {

			sbb-mux {
				compatible = "google,sbb-mux";
				default_signals = "gp_region_0", "gp_region_1", "gp_region_2", "gp_region_3";
				gpio_names = "C1_T0__XLSIOS_CLI2_PIN0", "C1_T1__XLSIOS_CLI2_PIN1", "C1_T3__XLSIOS_CLI2_PIN2", "C2_T0__XLSIOS_CLI2_PIN3";
				gpios = <0xffffffff 0xf 0x0 0xffffffff 0x10 0x0 0xffffffff 0x11 0x0 0xffffffff 0x12 0x0>;
				phandle = <0x292>;
			};
		};
	};

	fragment@touch_bus_negotiator {
		target-path = [2f 00];

		__overlay__ {

			tbn {
				compatible = "touch_bus_negotiator";
				phandle = <0x285>;
				tbn,mode = <0x3>;
			};
		};
	};

	fragment@typec {
		target-path = [2f 00];

		__overlay__ {

			google,usbc_port_cooling_dev {
				#cooling-cells = <0x2>;
				compatible = "google,usbc_port_cooling_dev";
				extcon = <0x64>;
				google,usb-cd-connected-interval-ms = <0x2bc>;
				google,usb-cd-polling-interval-ms = <0x1388>;
				google,usb-cd-unplug-interval-sec = <0x2>;
			};
		};
	};

	fragment@usb_data_role_switch {
		target-path = [2f 00];

		__overlay__ {

			goog_usb_role_sw {
				compatible = "google,usb-role-sw";
				eusb-role-sw-dev = <0x66>;
				phandle = <0x255>;
				role-sw-dev = <0xffffffff>;
				status = "okay";
			};
		};
	};
};
