				input-enable;
				output-high;
				phandle = <0x1f8>;
				pins = "XLSION_CLI16_PIN1";
			};

			ap2uwb_rst_l_1v2 {
				bias-disable;
				drive-strength = <0x0>;
				function = "lsion_gpio";
				input-enable;
				output-enable;
				phandle = <0xa2>;
				pins = "XLSION_CLI16_PIN0";
			};

			ap2uwb_rst_l_1v2_sleep {
				function = "lsion_gpio";
				input-enable;
				output-high;
				phandle = <0xa5>;
				pins = "XLSION_CLI16_PIN0";
			};

			xlsion_cli15_pin0 {
				bias-disable;
				drive-strength = <0x2>;
				function = "lsion_cli15";
				input-enable;
				output-enable;
				phandle = <0x28>;
				pins = "XLSION_CLI15_PIN0";
			};

			xlsion_cli15_pin0_sleep {
				function = "lsion_gpio";
				input-enable;
				output-low;
				phandle = <0x2b>;
				pins = "XLSION_CLI15_PIN0";
			};

			xlsion_cli15_pin1 {
				bias-disable;
				drive-strength = <0x2>;
				function = "lsion_cli15";
				input-enable;
				output-enable;
				phandle = <0x29>;
				pins = "XLSION_CLI15_PIN1";
			};

			xlsion_cli15_pin1_sleep {
				function = "lsion_gpio";
				input-enable;
				output-low;
				phandle = <0x2c>;
				pins = "XLSION_CLI15_PIN1";
			};

			xlsion_cli15_pin2 {
				bias-pull-down;
				function = "lsion_cli15";
				input-enable;
				output-disable;
				phandle = <0x2a>;
				pins = "XLSION_CLI15_PIN2";
			};

			xlsion_cli15_pin2_sleep {
				bias-pull-down;
				function = "lsion_gpio";
				input-enable;
				output-disable;
				phandle = <0x2d>;
				pins = "XLSION_CLI15_PIN2";
			};

			xlsion_cli15_pin3_ac6 {
				bias-disable;
				drive-strength = <0x2>;
				function = "lsion_gpio";
				input-enable;
				output-enable;
				phandle = <0x1f9>;
				pins = "XLSION_CLI15_PIN3";
			};

			xlsion_cli15_pin3_ac6_sleep {
				function = "lsion_gpio";
				input-enable;
				output-high;
				phandle = <0x1fa>;
				pins = "XLSION_CLI15_PIN3";
			};
		};
	};

	fragment@90 {
		target = <0xffffffff>;

		__overlay__ {
			usb-role-switch;
		};
	};

	fragment@91 {
		target = <0xffffffff>;

		__overlay__ {

			ports {

				port@0 {

					endpoint {
						phandle = <0x62>;
						remote-endpoint = <0x63>;
					};
				};
			};
		};
	};

	fragment@92 {
		target = <0xffffffff>;

		__overlay__ {

			eusb2_resetb_1v2 {
				bias-disable;
				drive-strength = <0x0>;
				function = "lsion_gpio";
				input-enable;
				phandle = <0x65>;
				pins = "XLSION_CLI16_PIN3";
			};
		};
	};

	fragment@93 {
		target = <0xffffffff>;

		__overlay__ {

			tiusb2e11@3E {
				compatible = "goog-eusb2-repeater";
				phandle = <0x66>;
				pinctrl-0 = <0x65>;
				pinctrl-names = "default";
				reg = <0x3e>;
				status = "okay";
				usb-role-switch;
				vdd18-supply = <0xffffffff>;
				vdd33-supply = <0xffffffff>;
				vdd_reset-supply = <0xffffffff>;
			};
		};
	};

	fragment@94 {
		target = <0xffffffff>;

		__overlay__ {

			ap2nfc_clk_1v2_func {
				bias-disable;
				drive-strength = <0x2>;
				function = "cpm_clkout";
				input-enable;
				output-enable;
				phandle = <0x6a>;
				pins = "XCPM_CLKOUT0";
			};

			ap2nfc_clk_1v2_sleep {
				bias-disable;
				drive-strength = <0x2>;
				function = "cpm_int";
				input-enable;
				output-low;
				phandle = <0x68>;
				pins = "XCPM_CLKOUT0";
			};
		};
	};

	fragment@95 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";

			st21nfc@8 {
				compatible = "st,st21nfc";
				dev-name = "st21nfc";
				interrupt-parent = <0xffffffff>;
				irq-gpios = <0xffffffff 0x3 0x0>;
				pidle-gpios = <0xffffffff 0x3 0x0>;
				pinctrl-0 = <0x67 0x68>;
				pinctrl-1 = <0x69 0x6a>;
				pinctrl-names = "default", "func";
				reg = <0x8>;
				reset-gpios = <0xffffffff 0x1 0x0>;
				st,clk_pinctrl_switch;
				st,extpad_control_en;
				st,pidle_active_check;
				status = "ok";
			};
		};
	};

	fragment@96 {
		target = <0xffffffff>;

		__overlay__ {

			cli15_3_wire_sleep {
				drive-open-drain;
				function = "lsion_gpio";
				phandle = <0x6b>;
				pins = "XLSION_CLI15_PIN0", "XLSION_CLI15_PIN1", "XLSION_CLI15_PIN2";
			};

			cli15_spi_cs_gpio_sleep {
				function = "lsion_gpio";
				output-enable;
				phandle = <0x2e>;
				pins = "XLSION_CLI15_PIN3";
			};
		};
	};

	fragment@97 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			cs-gpios = <0xffffffff 0x3 0x1>;
			pinctrl-0 = <0xffffffff 0xffffffff 0xffffffff>;
