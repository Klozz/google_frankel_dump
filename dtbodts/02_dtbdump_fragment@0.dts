	fragment@100 {
		target = <0xffffffff>;

		__overlay__ {

			cs40l27b@43 {
				cirrus,bst-ctl-microvolt = <0xa7d8c0>;
				cirrus,bst-dcm-en = <0x0>;
				cirrus,bst-expl-mode-disable;
				cirrus,bst-ipk-microamp = <0x2625a0>;
				cirrus,f0-default = <0x208000>;
				cirrus,pm-active-timeout-ms = <0x5>;
				cirrus,pwle-zero-cross-en;
				cirrus,redc-default = <0x68000>;
				cirrus,vpbr-enable;
				cirrus,vpbr-thld-uv = <0x2de600>;
				compatible = "cirrus,cs40l27b";
				dev-name = "cs40l26a";
				input-device-id = <0x0>;
				input-device-name = "cs40l26_input";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x2a 0x0 0x0>;
				pinctrl-0 = <0x6e 0x6f 0x70>;
				pinctrl-1 = <0x71 0x72 0x73>;
				pinctrl-names = "default", "sleep";
				reg = <0x43>;
				reset-gpios = <0xffffffff 0x1f 0x1>;
				status = "okay";

				cs40l26_codec@snd {
					#sound-dai-cells = <0x1>;
					compatible = "cs40l26-codec";
					phandle = <0x6d>;
					status = "okay";
				};
			};
		};
	};

	fragment@101 {
		target = <0xffffffff>;

		__overlay__ {

			bt-dev-wake {
				function = "aoc_cpm_eint";
				phandle = <0x74>;
				pins = "XAOC_GPIO1";
			};

			bt-host-wake {
				function = "aoc_cpm_eint";
				phandle = <0x75>;
				pins = "XAOC_GPIO2";
			};
		};
	};

	fragment@102 {
		target = <0xffffffff>;

		__overlay__ {

			timesync {
				function = "hsios_gpio";
				phandle = <0x258>;
				pins = "XHSIOS_VSYNC4";
			};
		};
	};

	fragment@103 {
		target = <0xffffffff>;

		__overlay__ {

			btbcm {
				bt-ble-dbo-le-gpios = <0xffffffff 0x14 0x0>;
				compatible = "goog,nitrous";
				device-wakeup-gpios = <0xffffffff 0xd 0x0>;
				host-wakeup-gpios = <0xffffffff 0x16 0x0>;
				phandle = <0x259>;
				pinctrl-0 = <0x74 0x75>;
				pinctrl-names = "default";
				shutdown-gpios = <0xffffffff 0x13 0x0>;
				status = "okay";
				timesync-gpios = <0xffffffff 0xe 0x0>;
			};
		};
	};

	fragment@104 {
		target = <0xffffffff>;

		__overlay__ {

			gnss@0 {
				compatible = "samsung,gnss-spi";
				reg = <0x0>;
				spi-max-frequency = <0x2faf08>;

				controller-data {
					samsung,spi-feedback-delay = <0x0>;
				};
			};
		};
	};

	fragment@105 {
		target = <0xffffffff>;

		__overlay__ {
			gnss-type = <0x2>;
		};
	};

