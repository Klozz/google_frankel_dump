				google,mdis-thermal-mitigation = <0x389c30 0x367d38 0x348938 0x324ee8 0x303f90 0x2e6300 0x2c8670 0x2ae090 0x293e98 0x27a470 0x260a48 0x238d90 0x2191c0 0x1fbd00 0x1e0780 0x1c7528 0x1b0210 0x19b220 0x185678 0x16fad0 0x1608a0 0x151670 0x149d58 0x142440 0x136ca8 0x12b128>;
