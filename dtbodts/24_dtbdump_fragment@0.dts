				sbi_lcd_status_pos = <0x1b>;
				sbi_lte_active_mask = <0x1>;
				sbi_lte_active_pos = <0x5>;
				sbi_pda_active_mask = <0x1>;
				sbi_pda_active_pos = <0x5>;
				sbi_uart_noti_mask = <0x1>;
				sbi_uart_noti_pos = <0x10>;
				srinfo_offset = <0x400000>;
				srinfo_size = <0x300000>;
				status = "okay";
				use-dynamic-link-spd;

				cpif_tpmon {
					boost_hold_msec = <0x1770>;
					monitor_hold_msec = <0xbb8>;
					monitor_interval_msec = <0x3e8>;
					monitor_stop_mbps = <0xf>;
					trigger_msec_max = <0x5dc>;
					trigger_msec_min = <0x1f4>;

					tpmon_cpu_cl0 {
						boost_name = "CL0";
						extra_idx = <0x0>;
						level = <0x0 0x104410 0x137090>;
						target = <0x9>;

						boost0 {
							boost_threshold = <0x64 0x12c>;
							enable = <0x0>;
							measure = <0x0>;
							proto = <0x1>;
							unboost_threshold_mbps = <0x28 0x78>;
						};
					};

					tpmon_cpu_cl1 {
						boost_name = "CL1";
						extra_idx = <0x4>;
						level = <0x0 0xc3118>;
						target = <0xa>;

						boost0 {
							boost_threshold = <0x7d0>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x320>;
						};
					};

					tpmon_gro_flush_time {
						boost_name = "GRO";
						extra_idx = <0x0>;
						level = <0x3d090 0x1e8480>;
						target = <0x1>;

						boost0 {
							boost_threshold = <0x64>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x32>;
						};
					};

					tpmon_irq_affinity_0 {
						boost_name = "IRQ_0";
						extra_idx = <0x3>;
						level = <0xc 0x1c>;
						target = <0x5>;

						boost0 {
							boost_threshold = <0x5dc>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x3e8>;
						};
					};

					tpmon_irq_dit {
						boost_name = "IRQ_DIT";
						extra_idx = <0x0>;
						level = <0x4 0x20>;
						target = <0x6>;

						boost0 {
							boost_threshold = <0xfa>;
							enable = <0x0>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x64>;
						};

						boost1 {
							boost_threshold = <0x1770>;
							enable = <0x0>;
							measure = <0x2>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x7d0>;
						};

						boost2 {
							boost_threshold = <0x1b58>;
							enable = <0x0>;
							measure = <0x3>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x7d0>;
						};
					};

					tpmon_mif {
						boost_name = "MIF";
						extra_idx = <0x0>;
						level = <0x0 0xf78f0>;
						target = <0x2>;

						boost0 {
							boost_threshold = <0x44c>;
							enable = <0x0>;
							measure = <0x0>;
							proto = <0x1>;
							unboost_threshold_mbps = <0x190>;
						};
					};

					tpmon_pcie_low_power {
						boost_name = "PCIE_LP";
						extra_idx = <0x0>;
						level = <0x1 0x0>;
						target = <0x3>;

						boost0 {
							boost_threshold = <0xbb8>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x4b0>;
						};
					};

					tpmon_rps {
						boost_name = "RPS";
						extra_idx = <0x0>;
						level = <0xc 0x1c>;
						target = <0x0>;

						boost0 {
							boost_threshold = <0x5dc>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x3e8>;
						};
					};
				};

				iodevs {

					io_device_0 {
						iod,attrs = <0x6000>;
						iod,ch = <0xf5>;
						iod,ch_count = <0x2>;
						iod,format = <0x0>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_ipc";
					};

					io_device_1 {
						iod,attrs = <0x0>;
						iod,ch = <0x29>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_rfs0";
					};

					io_device_10 {
						iod,attrs = <0x0>;
						iod,ch = <0x5c>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_rcs1";
					};

					io_device_11 {
						iod,attrs = <0x0>;
						iod,ch = <0x5d>;
						iod,format = <0x0>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_wfc0";
					};

					io_device_12 {
						iod,attrs = <0x0>;
						iod,ch = <0x5e>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_wfc1";
					};

					io_device_13 {
						iod,attrs = <0x2000>;
						iod,ch = <0x81>;
						iod,ch_count = <0x8>;
						iod,format = <0x0>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "oem_ipc";
					};

					io_device_14 {
						iod,attrs = <0x0>;
						iod,ch = <0x89>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "oem_test";
					};

					io_device_15 {
						iod,attrs = <0x200>;
						iod,ch = <0xf0>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "gnss_boot";
					};

					io_device_16 {
						iod,attrs = <0x200>;
						iod,ch = <0xef>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "gnss_dump";
					};

					io_device_17 {
						iod,attrs = <0x0>;
						iod,ch = <0x54>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "esim_tracer";
					};

					io_device_2 {
						iod,attrs = <0x0>;
						iod,ch = <0x15>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_router";
					};

					io_device_3 {
						iod,attrs = <0x4000>;
						iod,ch = <0x51>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_dm0";
					};

					io_device_4 {
						iod,attrs = <0x0>;
						iod,ch = <0x52>;
						iod,format = <0x1>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_loopback";
					};

					io_device_5 {
						iod,attrs = <0x2000>;
						iod,ch = <0xb5>;
						iod,ch_count = <0x1e>;
						iod,format = <0x1>;
						iod,io_type = <0x2>;
						iod,link_type = <0x1>;
						iod,name = "rmnet";
					};

					io_device_6 {
						iod,attrs = <0x0>;
						iod,ch = <0xd3>;
						iod,format = <0x1>;
						iod,io_type = <0x2>;
						iod,link_type = <0x1>;
						iod,name = "umts_dummy";
					};

					io_device_7 {
						iod,attrs = <0x0>;
						iod,ch = <0x0>;
						iod,format = <0x3>;
						iod,io_type = <0x3>;
						iod,link_type = <0x1>;
						iod,name = "multipdp";
					};

					io_device_8 {
						iod,attrs = <0x4200>;
						iod,ch = <0xf1>;
						iod,format = <0x4>;
						iod,io_type = <0x0>;
						iod,link_type = <0x1>;
						iod,name = "umts_boot0";
					};

					io_device_9 {
						iod,attrs = <0x0>;
						iod,ch = <0x5b>;
						iod,format = <0x0>;
						iod,io_type = <0x1>;
						iod,link_type = <0x1>;
						iod,name = "umts_rcs0";
					};
				};
			};

			gnssif {
				compatible = "samsung,exynos-gnss";
				device,name = "KEPLER";
				device_node_name = "gnss_ipc";
				gpio_ap2gnss_spi = <0xffffffff 0x12 0x1>;
				gpio_gnss2ap_spi = <0xffffffff 0x14 0x1>;
				pinctrl-0 = <0x57 0x58>;
				pinctrl-names = "default";
				status = "okay";
			};

			s5910_bb {
				#address-cells = <0x1>;
				#size-cells = <0x1>;
				clk-gpio = <0xffffffff 0x20 0x0>;
				compatible = "google,bitbang-spmi-controller";
				dat-gpio = <0xffffffff 0x21 0x0>;
				delay_us = <0xa>;
				phandle = <0x1e3>;
				pinctrl-0 = <0x55 0x56>;
				pinctrl-names = "default";
				status = "okay";

				pmic@0 {
					compatible = "google,cp-pmic-spmi";
					phandle = <0x54>;
					pmic-otp-reg = <0x30e>;
					reg = <0x0 0x0>;
					warm_reset_seq = <0x675 0xa1 0x0 0x67d 0xbe 0x0>;
				};

				s5910@5 {
					compatible = "google,s5910-spmi";
					phandle = <0x53>;
					reg = <0x5 0x0>;
					s5910,on_seq = <0x0 0x211 0x47 0x0 0x236 0xe 0x0 0x215 0x7f 0x0 0x20e 0x0>;
					s5910,seq = <0x0 0x215 0xf 0x3e8 0x20e 0x4 0x0 0x240 0x10>;
				};
			};
		};
	};

	fragment@rcam_supply {
		target-path = [2f 00];

		__overlay__ {

			rcam_supply@0 {
				compatible = "regulator-fixed";
				enable-active-high;
				gpio = <0xffffffff 0x2 0x0>;
				phandle = <0xac>;
				regulator-enable-ramp-delay = <0x3e8>;
				regulator-max-microvolt = <0x2191c0>;
				regulator-min-microvolt = <0x2191c0>;
				regulator-name = "PP2200_RCAM_ANA";
				status = "okay";
			};

			rcam_supply@1 {
				compatible = "regulator-fixed";
				enable-active-high;
				gpio = <0xffffffff 0x5 0x0>;
				phandle = <0xad>;
				regulator-enable-ramp-delay = <0x7d0>;
				regulator-max-microvolt = <0xe7ef0>;
				regulator-min-microvolt = <0xe7ef0>;
				regulator-name = "PP0950_RCAM";
				status = "okay";
			};
		};
	};

	fragment@sbbmux {
		target-path = [2f 00];

		__overlay__ {

			sbb-mux {
				compatible = "google,sbb-mux";
				default_signals = "gp_region_0", "gp_region_1", "gp_region_2", "gp_region_3";
				gpio_names = "C1_T0__XLSIOS_CLI2_PIN0", "C1_T1__XLSIOS_CLI2_PIN1", "C1_T3__XLSIOS_CLI2_PIN2", "C2_T0__XLSIOS_CLI2_PIN3";
				gpios = <0xffffffff 0xf 0x0 0xffffffff 0x10 0x0 0xffffffff 0x11 0x0 0xffffffff 0x12 0x0>;
				phandle = <0x1ef>;
			};
		};
	};

	fragment@touch_bus_negotiator {
		target-path = [2f 00];

		__overlay__ {

			tbn {
				compatible = "touch_bus_negotiator";
				phandle = <0x1ea>;
				tbn,mode = <0x2>;
			};
		};
	};

	fragment@typec {
		target-path = [2f 00];

		__overlay__ {

			google,usbc_port_cooling_dev {
				#cooling-cells = <0x2>;
				compatible = "google,usbc_port_cooling_dev";
				extcon = <0x64>;
				google,usb-cd-connected-interval-ms = <0x2bc>;
				google,usb-cd-polling-interval-ms = <0x1388>;
				google,usb-cd-unplug-interval-sec = <0x2>;
			};
		};
	};

	fragment@usb_data_role_switch {
		target-path = [2f 00];

		__overlay__ {

			goog_usb_role_sw {
				compatible = "google,usb-role-sw";
				eusb-role-sw-dev = <0x66>;
				phandle = <0x1e5>;
				role-sw-dev = <0xffffffff>;
				status = "okay";
			};
		};
	};
};
