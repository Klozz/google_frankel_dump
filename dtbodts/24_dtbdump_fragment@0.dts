	fragment@boardbase {
		target-path = [2f 00];

		__overlay__ {
			compatible = "google,lga-mustang", "google,lga";
			model = "MUSTANG Proto 1.1 Wingboard based on LGA";
		};
	};

	fragment@buttons {
		target-path = [2f 00];

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				phandle = <0x1e2>;
				pinctrl-0 = <0x1 0x2 0x3>;
				pinctrl-names = "default";
				status = "okay";

				button-power {
					gpios = <0xffffffff 0x30 0x1>;
					label = "gpio-keys: KEY_POWER";
					linux,code = <0x74>;
					wakeup-source;
				};

				button-voldn {
					gpios = <0xffffffff 0x33 0x1>;
					label = "gpio-keys: KEY_VOLUMEDOWN";
					linux,code = <0x72>;
					wakeup-source;
				};

				button-volup {
					gpios = <0xffffffff 0x34 0x1>;
					label = "gpio-keys: KEY_VOLUMEUP";
					linux,code = <0x73>;
					wakeup-source;
				};
			};
		};
	};

	fragment@camera_supply {
		target-path = [2f 00];

		__overlay__ {

			cam_supply@0 {
				compatible = "regulator-fixed";
				enable-active-high;
				gpio = <0xffffffff 0xf 0x0>;
				phandle = <0x7e>;
				regulator-enable-ramp-delay = <0x7d0>;
				regulator-max-microvolt = <0x149970>;
				regulator-min-microvolt = <0x149970>;
				regulator-name = "PP1350_CAM";
				status = "okay";
			};
		};
	};

	fragment@charging {
		target-path = [2f 00];

		__overlay__ {

			google,charger {
				#cooling-cells = <0x2>;
				compatible = "google,charger";
				google,bat-power-supply = "battery";
				google,bd-drainto-soc = <0x50>;
				google,bd-recharge-soc = <0x4f>;
				google,bd-recharge-voltage = <0x40d990>;
				google,bd-resume-abs-temp = <0x12c>;
				google,bd-resume-soc = <0x32>;
				google,bd-resume-temp = <0x122>;
				google,bd-resume-time = <0x3840>;
				google,bd-temp-enable;
				google,bd-trigger-temp = <0x190>;
				google,bd-trigger-time = <0x5460>;
				google,bd-trigger-voltage = <0x4127b0>;
				google,chg-power-supply = "main-charger";
				google,chg-taper-last-tier;
				google,chg-termination-5v;
				google,fv-max-uv = <0x47b760>;
				google,tcpm-power-supply = <0x64>;
				google,therm-wlc-overrides-fcc;
				google,thermal-stats-lvl-map = <0x0 0x8 0x10 0x19>;
				google,usb-power-supply = "usb";
				google,wlc-power-supply = "wireless";
				google,wlc-thermal-mitigation = <0x10c8e0 0x7a120 0x3d090 0x1adb0>;
				phandle = <0x1f1>;
			};

			google,cpm {
				#cooling-cells = <0x2>;
				compatible = "google,cpm";
				google,chg-power-supplies = "main-charger", "dc-mains";
				google,cop-supported;
				google,dc_limit-demand = <0x88b80>;
				google,dc_limit-vbatt = <0x426030>;
